<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd 定时任务配置
  
  安装：
    1. 把下面 PATH_TO_PROJECT 替换为项目真实绝对路径，例如 /Users/yourname/Documents/invest_brief
    2. 把 PATH_TO_PYTHON 替换为虚拟环境里 python 的绝对路径，例如 /Users/yourname/Documents/invest_brief/venv/bin/python
    3. 复制到 ~/Library/LaunchAgents/
    4. 加载：launchctl load ~/Library/LaunchAgents/com.user.invest_brief.plist
    5. 查看：launchctl list | grep invest_brief
    6. 卸载：launchctl unload ~/Library/LaunchAgents/com.user.invest_brief.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.invest_brief</string>

    <key>ProgramArguments</key>
    <array>
        <string>PATH_TO_PYTHON</string>
        <string>PATH_TO_PROJECT/src/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>PATH_TO_PROJECT</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>PATH_TO_PROJECT/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>PATH_TO_PROJECT/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
        <key>LC_ALL</key>
        <string>zh_CN.UTF-8</string>
    </dict>
</dict>
</plist>
