# 复制为 .env 后填入真实 key
# .env 已在 .gitignore，不会进版本控制

# DeepSeek API（必填）
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# SiliconFlow API（FinSight VLM + Embedding，免费额度）
# 申请：https://siliconflow.cn
SILICONFLOW_API_KEY=sk-xxx

# Serper 搜索 API（FinSight 搜索用，免费 2500 次/月）
# 申请：https://serper.dev
SERPER_API_KEY=xxx

# Tavily 搜索 API（Dexter 问答用，可选）
# 申请：https://app.tavily.com
TAVILY_API_KEY=tvly-xxx

# Server 酱（必填，微信推送）
# 申请：https://sct.ftqq.com 扫码绑定
SERVERCHAN_KEY=SCTxxxxxxxxxxxxxxxxxxxxxxxx

# Wind（可选，留空则用当前登录账号）
WIND_USER=
WIND_PASSWORD=

# 邮件（可选备用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# 调试
DRY_RUN=false
LOG_LEVEL=INFO
