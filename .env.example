# 复制为 .env 后填入真实 key
# .env 已在 .gitignore，不会进版本控制

# DeepSeek API（必填）
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Server 酱（必填，微信推送）
# 申请：https://sct.ftqq.com 扫码绑定
SERVERCHAN_KEY=SCTxxxxxxxxxxxxxxxxxxxxxxxx

# Wind（可选，留空则用当前登录账号）
WIND_USER=
WIND_PASSWORD=

# 邮件（可选备用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# 调试
DRY_RUN=false
LOG_LEVEL=INFO
